rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Product catalog: Anyone can view, authorized sellers can write
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Or request.auth != null for production secured
    }
    
    // Orders collection: Anyone can create orders, read order history
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Protect orders from tampering
    }
    
    // Inventory supply logs
    match /inventory_logs/{logId} {
      allow read: if true;
      allow create: if true;
    }
  }
}
